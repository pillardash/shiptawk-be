APP_NAME="Backend API"
APP_VERSION="0.1.0"
APP_ENV="local"
DEBUG=false
API_PREFIX="/v1"
PORT=8000
WORKERS=1
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
PROXY_HEADERS=true
FORWARDED_ALLOW_IPS="*"
TRUSTED_PROXY_IPS=""

POSTGRES_DB="app"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/app"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
CORS_ALLOW_CREDENTIALS=true
ALLOWED_HOSTS="*"

LOG_LEVEL="INFO"
LOG_FORMAT="console"
LOG_FILE_ENABLED=true
LOG_FILE_PATH="logs/errors.log"
AI_CONTENT_LOG_ENABLED=false
AI_CONTENT_LOG_PATH="logs/ai.log"

JWT_SECRET_KEY="change-me"
# Must match the frontend TOKEN_ENCRYPTION_KEY until legacy email jobs move to FastAPI.
TOKEN_ENCRYPTION_KEY=
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="backend-api"
JWT_AUDIENCE="backend-api"
OAUTH_TRANSACTION_EXPIRE_MINUTES=10
OAUTH_TRANSACTION_ENCRYPTION_KEY=
OAUTH_ENABLED_PROVIDERS=
OAUTH_HTTP_TIMEOUT_SECONDS=10
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Google browser login callback:
# ${PUBLIC_BACKEND_URL}${API_PREFIX}/auth/browser/oauth/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
X_OAUTH_ENABLED=false
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_SCOPES="tweet.read tweet.write users.read offline.access"
# Independent Fernet key for provider access and refresh tokens.
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=
PUBLIC_BACKEND_URL="http://localhost:8000"
# Google Search Console integration (separate OAuth client and callback):
# Local: http://localhost:8000/v1/integrations/search/google/callback
# Production: https://api.shiptawk.com/v1/integrations/search/google/callback
GOOGLE_SEARCH_ENABLED=false
GOOGLE_SEARCH_CLIENT_ID=
GOOGLE_SEARCH_CLIENT_SECRET=
GITHUB_APP_ID=
# PEM private key; use a multiline-capable secret in production.
GITHUB_APP_PRIVATE_KEY=
# Public endpoint: ${PUBLIC_BACKEND_URL}${API_PREFIX}/webhooks/github
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=
# Fernet key generated independently from the OAuth transaction key.
GITHUB_WEBHOOK_PAYLOAD_ENCRYPTION_KEY=
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576

# Backend-owned durable workflows. Function endpoint: ${PUBLIC_BACKEND_URL}/api/inngest
INNGEST_ENABLED=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional local/self-hosted Inngest origin, for example http://inngest:8288
INNGEST_EVENT_API_BASE_URL=
INNGEST_REQUEST_TIMEOUT_SECONDS=10
# Competing legacy email schedules remain available for rollback, but are off for the MVP.
LEGACY_DAILY_DRAFT_SCHEDULE_ENABLED=false
LEGACY_ACHIEVEMENT_DIGEST_SCHEDULES_ENABLED=false
LEGACY_REPOSITORY_CHANGELOG_SCHEDULES_ENABLED=false
# Controls only the canonical weekly operator scheduler, not legacy digest schedules.
WEEKLY_GROWTH_SCHEDULE_ENABLED=true
GENERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GENERATION_TIMEOUT_SECONDS=30

# Browser OAuth/session cookies. Leave DOMAIN empty for host-only cookies.
BROWSER_COOKIE_SECURE=false
BROWSER_COOKIE_DOMAIN=
BROWSER_COOKIE_SAMESITE="lax"
BROWSER_ACCESS_COOKIE_NAME="access_token"
BROWSER_REFRESH_COOKIE_NAME="refresh_token"
BROWSER_REFRESH_COOKIE_PATH="/"
BROWSER_CSRF_COOKIE_NAME="csrf_token"
BROWSER_CSRF_HEADER_NAME="X-CSRF-Token"
BROWSER_ALLOWED_ORIGINS="http://localhost:3000"

# Security and API surface
OPENAPI_ENABLED=
DOCS_ENABLED=
REDOC_ENABLED=
MAX_REQUEST_BODY_BYTES=1048576
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=
HSTS_MAX_AGE_SECONDS=31536000
REFERRER_POLICY="no-referrer"
PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=()"
EXPOSE_ERROR_DETAILS=

# Rate limiting and cache
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_BACKEND="memory"
REDIS_URL=
# Email
FRONTEND_URL="http://localhost:3000"
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGNED_URL_EXPIRE_SECONDS=900

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# Background jobs
JOBS_BACKEND="inline"
JOBS_QUEUE_NAME="default"
JOBS_REDIS_URL=
JOBS_DEFAULT_TIMEOUT_SECONDS=300
JOBS_RESULT_TTL_SECONDS=86400
JOBS_FAILURE_TTL_SECONDS=604800
JOBS_EMAIL_QUEUE="email"
JOBS_FILES_QUEUE="files"
JOBS_AI_QUEUE="ai"
JOBS_REPORTS_QUEUE="reports"
JOBS_WEBHOOKS_QUEUE="webhooks"
JOBS_NOTIFICATIONS_QUEUE="notifications"

OAUTH_ENABLED_PROVIDERS=google,github
GOOGLE_LOGIN_CLIENT_ID=...
GOOGLE_LOGIN_CLIENT_SECRET=...
GOOGLE_SEARCH_CLIENT_ID=...
GOOGLE_SEARCH_CLIENT_SECRET=...
