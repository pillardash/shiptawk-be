APP_NAME="Backend API"
APP_VERSION="0.1.0"
APP_ENV="local"
DEBUG=false
API_PREFIX="/api/v1"
PORT=8000
WORKERS=1
PROXY_HEADERS=true
FORWARDED_ALLOW_IPS="*"
TRUSTED_PROXY_IPS=""

POSTGRES_DB="app"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/app"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
CORS_ALLOW_CREDENTIALS=true
ALLOWED_HOSTS="*"

LOG_LEVEL="INFO"
LOG_FORMAT="console"

JWT_SECRET_KEY="change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Security and API surface
OPENAPI_ENABLED=
DOCS_ENABLED=
REDOC_ENABLED=
MAX_REQUEST_BODY_BYTES=1048576
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=
HSTS_MAX_AGE_SECONDS=31536000
REFERRER_POLICY="no-referrer"
PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=()"
EXPOSE_ERROR_DETAILS=

# Rate limiting and cache
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_BACKEND="memory"
REDIS_URL=
LOGIN_THROTTLE_ENABLED=true
LOGIN_THROTTLE_IP_REQUESTS=10
LOGIN_THROTTLE_EMAIL_REQUESTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=300
PASSWORD_RESET_THROTTLE_IP_REQUESTS=10
PASSWORD_RESET_THROTTLE_TOKEN_REQUESTS=5
PASSWORD_RESET_THROTTLE_WINDOW_SECONDS=300

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_DIGIT=true

# Email
FRONTEND_URL="http://localhost:3000"
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGNED_URL_EXPIRE_SECONDS=900

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# Background jobs
JOBS_BACKEND="inline"
JOBS_QUEUE_NAME="default"
JOBS_REDIS_URL=
JOBS_DEFAULT_TIMEOUT_SECONDS=300
JOBS_RESULT_TTL_SECONDS=86400
JOBS_FAILURE_TTL_SECONDS=604800
JOBS_EMAIL_QUEUE="email"
JOBS_FILES_QUEUE="files"
JOBS_AI_QUEUE="ai"
JOBS_REPORTS_QUEUE="reports"
JOBS_WEBHOOKS_QUEUE="webhooks"
JOBS_NOTIFICATIONS_QUEUE="notifications"
